# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Required. Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
LLM_PROVIDER=groq

# Optional: local Postgres override (defaults to the docker-compose instance)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/property_insights

# Optional: LangGraph/LangSmith tracing (https://smith.langchain.com)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_PROJECT=property-insights-assistant

# Optional: fraction of rag/risk answers the LLM-as-judge samples (default 0.3)
# JUDGE_SAMPLE_RATE=0.3

# --- Azure mode (optional) --------------------------------------------------
# Not required for local dev — only needed if you set LLM_PROVIDER=azure below.
# See README.md's "Running against Azure" section for the full picture of
# what each of these backs.

# LLM_PROVIDER=azure

# Optional: real Postgres instead of the local docker-compose one
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<db>?sslmode=require

# Required if LLM_PROVIDER=azure: Azure OpenAI (chat + embeddings)
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# Required if LLM_PROVIDER=azure: Azure AI Search (agent/retriever.py's
# hybrid keyword+vector backend — see scripts/build_search_index.py)
# AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# AZURE_SEARCH_API_KEY=your-azure-search-key-here
# AZURE_SEARCH_INDEX=listings

# Required if LLM_PROVIDER=azure: Azure ML managed online endpoint serving
# the cancellation-risk model (see ml/azure/endpoint.yml, ml/azure/deployment.yml)
# AZURE_ML_RISK_ENDPOINT_URL=https://<your-endpoint-name>.<region>.inference.ml.azure.com/score
# AZURE_ML_RISK_ENDPOINT_KEY=your-azure-ml-endpoint-key-here
